<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 500" width="100%" height="100%">
  <defs>
    <linearGradient id="sky" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#1e293b" />
      <stop offset="100%" stop-color="#0f172a" />
    </linearGradient>
    <linearGradient id="road" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#334155" />
      <stop offset="50%" stop-color="#475569" />
      <stop offset="100%" stop-color="#334155" />
    </linearGradient>
    <linearGradient id="trunk" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#78350f" />
      <stop offset="100%" stop-color="#451a03" />
    </linearGradient>
  </defs>
  <!-- Background / Sky -->
  <rect width="800" height="500" fill="url(#sky)" />
  <!-- Road Surface -->
  <polygon points="100,500 700,500 480,260 320,260" fill="url(#road)" />
  <line x1="400" y1="260" x2="400" y2="500" stroke="#facc15" stroke-width="6" stroke-dasharray="24,16" />
  
  <!-- Fallen Tree Trunk Blocking Road -->
  <path d="M 220,380 Q 420,350 620,390 L 630,420 Q 420,380 210,410 Z" fill="url(#trunk)" stroke="#292524" stroke-width="3" />
  <!-- Broken Branches & Foliage -->
  <circle cx="280" cy="370" r="45" fill="#15803d" opacity="0.9" />
  <circle cx="340" cy="350" r="55" fill="#166534" opacity="0.9" />
  <circle cx="410" cy="360" r="60" fill="#14532d" opacity="0.9" />
  <circle cx="480" cy="350" r="50" fill="#15803d" opacity="0.9" />
  <circle cx="550" cy="380" r="45" fill="#166534" opacity="0.9" />

  <!-- Warning Banner Overlay -->
  <rect x="250" y="440" width="300" height="40" rx="8" fill="#ef4444" opacity="0.9" />
  <text x="400" y="465" font-family="sans-serif" font-size="16" font-weight="bold" fill="#ffffff" text-anchor="middle">
    HAZARD: ARTERIAL ROAD BLOCKED
  </text>
</svg>
